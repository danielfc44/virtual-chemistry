---
import Layout from '../layouts/Layout.astro';
import SceneHotspots from '../components/SceneHotspots.astro';
import MoleculeDirectory from '../components/MoleculeDirectory.astro';
import MoleculeModal from '../components/MoleculeModal.astro';
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">Laboratório Virtual de Química</p>
			<h1>Moléculas do dia a dia</h1>
			<p class="lead">
				Explore uma cena comum ao ar livre e descubra as moléculas escondidas nela. Clique num
				ponto brilhante na ilustração — ou num cartão abaixo — para abrir um modelo 3D e ver a
				sua composição qualitativa, composição quantitativa e geometria molecular.
			</p>
		</header>

		<section aria-label="Cena interativa">
			<SceneHotspots />
		</section>

		<section class="directory-section" aria-label="Todas as moléculas">
			<h2>Ou vá diretamente para uma molécula</h2>
			<MoleculeDirectory />
		</section>
	</main>

	<MoleculeModal />
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 40px 20px 80px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.page-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		font-weight: 700;
		color: #2563eb;
		margin: 0 0 8px;
	}

	h1 {
		margin: 0 0 12px;
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		color: #0f172a;
	}

	.lead {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.6;
		color: #475569;
	}

	.directory-section h2 {
		font-size: 1.1rem;
		color: #0f172a;
		margin: 0 0 16px;
		text-align: center;
	}
</style>

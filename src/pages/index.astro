---
import Layout from '../layouts/Layout.astro';
import MoleculeScene from '../components/MoleculeScene.astro';
import MoleculeList from '../components/MoleculeList.astro';
import MoleculeInfo from '../components/MoleculeInfo.astro';
---

<Layout>
	<main class="page">
		<header class="page-header">
			<p class="eyebrow">Laboratório Virtual de Química</p>
			<h1>Lupa mágica molécular</h1>
			<p class="lead">
				Explore uma paisagem do quotidiano e descubra as moléculas escondidas nela. Passe o rato
				ou clique num ponto brilhante da imagem — ou num cartão da lista abaixo — para ver o
				modelo 3D a rodar no local, com a sua relevância, composição qualitativa, composição
				quantitativa e geometria molecular.
			</p>
		</header>

		<section aria-label="Cena interativa">
			<MoleculeScene />
		</section>

		<section class="directory-section" aria-label="Todas as moléculas">
			<h2>Ou vá diretamente para uma molécula</h2>
			<MoleculeList />
		</section>

		<section aria-label="Detalhes da molécula selecionada">
			<MoleculeInfo />
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 40px 20px 80px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.page-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		font-weight: 700;
		color: #2563eb;
		margin: 0 0 8px;
	}

	h1 {
		margin: 0 0 12px;
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		color: #0f172a;
	}

	.lead {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.6;
		color: #475569;
	}

	.directory-section h2 {
		font-size: 1.1rem;
		color: #0f172a;
		margin: 0 0 16px;
		text-align: center;
	}
</style>
